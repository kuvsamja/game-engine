#version 330 core

in vec2 frag_uv;

uniform sampler2D color_texture;
uniform sampler2D light_texture;
uniform sampler2D ignore_light_texture;

out vec4 out_color;

void main() {
    if(texture(ignore_light_texture, frag_uv).r >= 0.1) {
        out_color = texture(color_texture, frag_uv);
        return;
    }
    vec4 color = texture(color_texture, frag_uv) * texture(light_texture, frag_uv);
    color = vec4(
        min(color.r, 1),
        min(color.g, 1),
        min(color.b, 1),
        min(color.a, 1)
    );
    out_color = color;
}