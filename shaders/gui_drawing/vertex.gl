#version 330 core

layout(location = 0) in vec2 in_corner;
layout(location = 1) in vec2 in_uv;

uniform vec2 pixel_viewport_size;
uniform vec2 pixel_sprite_position;
uniform vec2 pixel_sprite_size;

out vec2 frag_uv;


void main() {
    vec2 screen_point_position = pixel_sprite_position + in_corner*pixel_sprite_size;

    vec2 ndc = (screen_point_position / pixel_viewport_size) * 2.0 - 1.0;

    gl_Position = vec4(ndc.x, ndc.y, 0.0, 1.0);
    frag_uv = in_uv;
}
