#version 330 core

in vec2 frag_uv;

uniform sampler2D sprite_texture;
uniform sampler2D sprite_normal_map;
uniform bool has_normal_map;
uniform float z;

layout(location = 0) out vec4 out_color;
layout(location = 1) out vec4 out_normal_map_vector;
layout(location = 2) out float out_depth;
layout(location = 3) out float out_ignore_light;


void main() {
    vec4 pixel_color = texture(sprite_texture, frag_uv);
    if (pixel_color.a < 0.01) discard;
    out_color = pixel_color;
    if (has_normal_map)
        out_normal_map_vector = vec4(texture(sprite_normal_map, frag_uv).rgb * 2.0 - 1.0, 1.0);
    else
        out_normal_map_vector = vec4(0.0, 0.0, 1.0, 0.0);
    
    out_depth = z;
    out_ignore_light = has_normal_map ? 0.0 : 1.0;
}
